<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Base Website Template -->
    <template id="website_base" name="Real Estate Base Layout">
            <t t-call="website.layout">
                <div id="wrapwrap">
                    <!-- Navbar -->
                    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
                        <div class="container">
                            <a class="navbar-brand font-weight-bold text-primary" href="/">
                                <i class="fa fa-building" title="SGC TECH AI Real Estate"></i> SGC TECH AI
                            </a>
                            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav">
                                <span class="navbar-toggler-icon"></span>
                            </button>
                            <div class="collapse navbar-collapse" id="navbarNav">
                                <ul class="navbar-nav ml-auto">
                                    <li class="nav-item">
                                        <a class="nav-link" href="/properties">Properties</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" href="/properties/destinations">Destinations</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link btn btn-primary text-white ml-2" href="/consultation">Contact</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </nav>

                    <!-- Main Content (render child templates here) -->
                    <main>
                        <t t-esc="0"/>
                    </main>

                    <!-- Footer - Mobile First -->
                    <footer class="bg-dark text-white py-5 mt-5">
                        <div class="container">
                            <!-- Footer Grid - Responsive -->
                            <div class="footer-grid">
                                <!-- Column 1: Brand -->
                                <div class="footer-column">
                                    <h5>SGC TECH AI</h5>
                                    <p class="small">Your trusted partner in finding the perfect property worldwide.</p>
                                </div>
                                
                                <!-- Column 2: Quick Links -->
                                <div class="footer-column">
                                    <h6>Quick Links</h6>
                                    <ul>
                                        <li><a href="/properties">Properties</a></li>
                                        <li><a href="/properties/destinations">Destinations</a></li>
                                        <li><a href="/consultation">Contact</a></li>
                                    </ul>
                                </div>
                                
                                <!-- Column 3: Contact -->
                                <div class="footer-column">
                                    <h6>Contact</h6>
                                    <p class="small">
                                        Email: info@SGC TECH AI.com<br/>
                                        Phone: +1 (555) 123-4567
                                    </p>
                                </div>

                                <!-- Column 4: Social (Desktop) -->
                                <div class="footer-column">
                                    <h6>Follow Us</h6>
                                    <ul>
                                        <li><a href="#">Facebook</a></li>
                                        <li><a href="#">LinkedIn</a></li>
                                        <li><a href="#">Twitter</a></li>
                                    </ul>
                                </div>
                            </div>
                            
                            <!-- Footer Bottom -->
                            <div class="footer-bottom mt-4">
                                <p>© 2025 SGC TECH AI. All rights reserved.</p>
                            </div>
                        </div>
                    </footer>
                </div>
            </t>
        </template>

    <!-- Homepage Hero Section -->
    <template id="homepage_hero" name="Homepage Hero Section">
            <div class="hero-section">
                <div class="container">
                    <h1>Find Your Dream Property</h1>
                    <p class="lead">Explore premium real estate opportunities around the world</p>
                    <a href="/properties" class="btn btn-secondary btn-lg">Browse Properties</a>
                </div>
            </div>
        </template>

<!-- Statistics Section -->
    <template id="homepage_stats" name="Homepage Statistics">
            <div class="stats-section">
                <div class="container">
                    <div class="row">
                        <div class="col-md-6 stat-item">
                            <div class="stat-number" t-esc="stats.get('country_count', 0)"/>
                            <div class="stat-label">Countries</div>
                        </div>
                        <div class="col-md-6 stat-item">
                            <div class="stat-number" t-esc="stats.get('property_count', 0)"/>
                            <div class="stat-label">Premium Properties</div>
                        </div>
                    </div>
                </div>
            </div>
        </template>

    <!-- Featured Properties Section -->
    <template id="homepage_featured_properties" name="Homepage Featured Properties">
        <div class="featured-properties-section py-5">
            <div class="container">
                <div class="row mb-4 align-items-end">
                    <div class="col-md-8">
                        <h2 class="mb-1">Featured Properties</h2>
                        <p class="text-muted mb-0">Hand-picked listings from our global portfolio.</p>
                    </div>
                    <div class="col-md-4 text-md-right">
                        <a href="/properties" class="btn btn-outline-primary">
                            View all <span class="fa fa-arrow-right" title="View all"/>
                        </a>
                    </div>
                </div>
                <div class="row" t-if="featured_properties">
                    <div class="col-md-6 col-lg-4 mb-4" t-foreach="featured_properties" t-as="prop">
                        <div class="property-card card h-100 shadow-sm">
                            <div class="position-relative overflow-hidden" style="height: 220px;">
                                <img t-if="prop.image_1920"
                                     t-att-src="'/web/image/sgc.realestate.property/%s/image_512' % prop.id"
                                     class="card-img-top"
                                     style="height: 100%; object-fit: cover;"
                                     t-att-alt="prop.title"/>
                                <div t-if="not prop.image_1920"
                                     class="bg-light d-flex align-items-center justify-content-center h-100">
                                    <span class="fa fa-home fa-3x text-muted" title="No image"/>
                                </div>
                                <div class="position-absolute" style="top: 10px; right: 10px;">
                                    <span class="badge badge-primary" t-esc="(prop.property_type or '').title()"/>
                                </div>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title" t-esc="prop.title or prop.name"/>
                                <p class="text-muted small mb-2">
                                    <span class="fa fa-map-marker" title="Location"/>
                                    <span t-esc="prop.city"/>
                                    <span t-if="prop.destination_country_id">,
                                        <span t-esc="prop.destination_country_id.name"/>
                                    </span>
                                </p>
                                <div class="mt-auto d-flex justify-content-between align-items-center">
                                    <h5 class="text-primary mb-0" t-esc="'%s %.0f' % (prop.currency_id.symbol or '$', prop.price)"/>
                                    <a t-att-href="prop.website_url or ('/property/%s' % prop.id)" class="btn btn-sm btn-outline-primary">View</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div t-if="not featured_properties" class="alert alert-info text-center">
                    <span class="fa fa-info-circle" title="No listings"/>
                    No published properties yet. New listings appear here as soon as they go live.
                </div>
            </div>
        </div>
    </template>

    <!-- Destinations Section -->
    <template id="homepage_destinations" name="Homepage Destinations">
        <div class="destinations-section py-5 bg-light">
            <div class="container">
                <div class="row mb-4 align-items-end">
                    <div class="col-md-8">
                        <h2 class="mb-1">Destinations</h2>
                        <p class="text-muted mb-0">Explore properties by country.</p>
                    </div>
                </div>
                <div class="row" t-if="countries">
                    <div class="col-md-6 col-lg-4 mb-4" t-foreach="countries" t-as="c">
                        <a t-att-href="'/realestate/destination/%s' % c.id" class="text-decoration-none">
                            <div class="destination-card card h-100 shadow-sm border-0">
                                <div class="position-relative overflow-hidden" style="height: 180px;">
                                    <img t-if="c.image_1920"
                                         t-att-src="'/web/image/sgc.realestate.destination.country/%s/image_512' % c.id"
                                         class="card-img-top"
                                         style="height: 100%; object-fit: cover;"
                                         t-att-alt="c.name"/>
                                    <div t-if="not c.image_1920"
                                         class="bg-secondary d-flex align-items-center justify-content-center h-100">
                                        <span class="fa fa-globe fa-3x text-white" title="Country"/>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <h5 class="card-title text-dark mb-1" t-esc="c.name"/>
                                    <p class="text-muted small mb-0">
                                        <span t-esc="c.property_count"/>
                                        <span t-if="c.property_count == 1"> property</span>
                                        <span t-else=""> properties</span>
                                    </p>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
                <div t-if="not countries" class="alert alert-info text-center">
                    No published destinations yet.
                </div>
            </div>
        </div>
    </template>

    <!-- Homepage Complete -->
    <template id="homepage" name="Homepage">
        <t t-call="sgc_realestate_website.website_base">
            <t t-call="sgc_realestate_website.homepage_hero"/>
            <t t-call="sgc_realestate_website.homepage_stats"/>
            <t t-call="sgc_realestate_website.homepage_featured_properties"/>
            <t t-call="sgc_realestate_website.homepage_destinations"/>
        </t>
    </template>
</odoo>

