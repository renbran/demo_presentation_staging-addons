<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Destination Country Tree View -->
    <record id="view_destination_country_tree" model="ir.ui.view">
        <field name="name">sgc.realestate.destination.country.tree</field>
        <field name="model">sgc.realestate.destination.country</field>
        <field name="arch" type="xml">
            <list string="Destinations" editable="top">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="property_count"/>
                <field name="website_published"/>
            </list>
        </field>
    </record>

    <!-- Destination Country Form View -->
    <record id="view_destination_country_form" model="ir.ui.view">
        <field name="name">sgc.realestate.destination.country.form</field>
        <field name="model">sgc.realestate.destination.country</field>
        <field name="arch" type="xml">
            <form string="Destination">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_properties" type="object" 
                                class="oe_stat_button" icon="fa-home">
                            <field string="Properties" name="property_count" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Country Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g., US, UK, AE"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="website_published" widget="boolean_toggle"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="website_url" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Description or overview of this destination"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Destination Country Kanban View -->
    <record id="view_destination_country_kanban" model="ir.ui.view">
        <field name="name">sgc.realestate.destination.country.kanban</field>
        <field name="model">sgc.realestate.destination.country</field>
        <field name="arch" type="xml">
            <kanban string="Destinations" class="o_kanban_small_column">
                <field name="id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="property_count"/>
                <field name="website_published"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card">
                            <div class="oe_kanban_card_header">
                                <div class="o_kanban_card_header_title">
                                    <h4>
                                        <a type="open">
                                            <field name="name"/>
                                        </a>
                                    </h4>
                                </div>
                                <div class="o_dropdown_kanban dropdown">
                                      <a class="dropdown-toggle o_kanban_manage_toggle_button" href="#" data-toggle="dropdown">
                                          <span class="fa fa-ellipsis-v" title="Actions" aria-label="Actions"/>
                                    </a>
                                    <div class="dropdown-menu" role="menu">
                                        <a role="menuitem" type="edit" class="dropdown-item">Edit</a>
                                        <a role="menuitem" type="delete" class="dropdown-item">Delete</a>
                                    </div>
                                </div>
                            </div>
                            <div class="oe_kanban_card_content">
                                <p><strong>Code:</strong> <field name="code"/></p>
                                <p><strong>Properties:</strong> <field name="property_count"/></p>
                            </div>
                            <div class="oe_kanban_card_footer">
                                <span t-if="record.website_published.raw_value" class="badge badge-success">Published</span>
                                <span t-else="" class="badge badge-secondary">Draft</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Destination Country Search View -->
    <record id="view_destination_country_search" model="ir.ui.view">
        <field name="name">sgc.realestate.destination.country.search</field>
        <field name="model">sgc.realestate.destination.country</field>
        <field name="arch" type="xml">
            <search string="Destinations">
                <field name="name" string="Country Name"/>
                <field name="code" string="Country Code"/>
                <separator/>
                <filter string="Published" name="published" domain="[('website_published', '=', True)]"/>
                <filter string="Unpublished" name="unpublished" domain="[('website_published', '=', False)]"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <separator/>
                <group>
                    <filter string="Published" name="group_published" context="{'group_by': 'website_published'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================== -->
    <!-- Public website: country destination landing page              -->
    <!-- Backs /realestate/destination/<country> defined in main.py     -->
    <!-- (controller renders 'sgc_realestate_website.destination_page' -->
    <!-- with vars: country, properties).                                -->
    <!-- ============================================================== -->
    <template id="destination_page" name="Country Destination Page">
        <t t-call="sgc_realestate_website.website_base">
            <t t-set="additional_title" t-value="country.name"/>

            <div class="container my-5 destination-page">
                <!-- Hero -->
                <div class="row mb-4 align-items-center">
                    <div class="col-md-7 col-sm-12">
                        <h1 class="mb-2">
                            Properties in
                            <span t-esc="country.name"/>
                        </h1>
                        <p class="text-muted mb-0" t-if="country.short_description" t-esc="country.short_description"/>
                        <p class="text-muted mb-0" t-else="">
                            Browse available properties in
                            <span t-esc="country.name"/>.
                        </p>
                    </div>
                    <div class="col-md-5 col-sm-12 text-md-right">
                        <span class="badge badge-primary p-2">
                            <span t-esc="len(properties)"/>
                            <span t-if="len(properties) == 1"> property available</span>
                            <span t-else=""> properties available</span>
                        </span>
                    </div>
                </div>

                <!-- Country hero image -->
                <div t-if="country.image_1920" class="mb-4">
                    <img t-att-src="'/web/image/sgc.realestate.destination.country/%s/image_1920' % country.id"
                         class="img-fluid rounded shadow-sm w-100"
                         style="max-height: 360px; object-fit: cover;"
                         t-att-alt="'Properties in %s' % country.name"/>
                </div>

                <!-- Long description (HTML, sanitized at the model) -->
                <div t-if="country.description" class="mb-5 country-description">
                    <t t-out="country.description"/>
                </div>

                <!-- Property grid (same card markup style as the global listing) -->
                <div class="property-grid">
                    <div class="row" id="destinationPropertyContainer">
                        <t t-if="properties">
                            <div class="col-md-6 col-lg-4 mb-4" t-foreach="properties" t-as="prop">
                                <div class="property-card card h-100 shadow-sm"
                                     t-att-data-country="prop.destination_country_id.id"
                                     t-att-data-type="prop.property_type"
                                     t-att-data-price="prop.price">
                                    <div class="position-relative overflow-hidden" style="height: 250px;">
                                        <img t-if="prop.image_1920"
                                             t-att-src="'/web/image/sgc.realestate.property/%s/image_512' % prop.id"
                                             class="card-img-top"
                                             style="height: 100%; object-fit: cover;"
                                             t-att-alt="prop.title"/>
                                        <div class="position-absolute" style="top: 10px; right: 10px;">
                                            <span class="badge badge-primary" t-esc="(prop.property_type or '').title()"/>
                                        </div>
                                    </div>
                                    <div class="card-body d-flex flex-column">
                                        <h5 class="card-title" t-esc="prop.title or prop.name"/>
                                        <p class="text-muted small mb-2 property-location">
                                            <span class="fa fa-map-marker" title="Location"/>
                                            <span t-esc="prop.city"/>
                                        </p>
                                        <div class="mb-3">
                                            <span class="badge badge-info mr-1" t-esc="('%s bed' % prop.bedrooms) if prop.bedrooms else 'Studio'"/>
                                            <span class="badge badge-info mr-1" t-esc="('%s bath' % prop.bathrooms) if prop.bathrooms else '1 bath'"/>
                                            <span class="badge badge-info" t-esc="('%s sqm' % prop.area) if prop.area else ''"/>
                                        </div>
                                        <p class="card-text small text-muted flex-grow-1" t-esc="prop.description and prop.description[:120]"/>
                                        <div class="d-flex justify-content-between align-items-center mt-auto">
                                            <h4 class="text-primary mb-0" t-esc="'%s %.0f' % (prop.currency_id.symbol or '$', prop.price)"/>
                                            <a t-att-href="prop.website_url or ('/property/%s' % prop.id)" class="btn btn-sm btn-outline-primary">
                                                View Details
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                        <t t-if="not properties">
                            <div class="col-12">
                                <div class="alert alert-info text-center">
                                    <span class="fa fa-info-circle" title="No results"/>
                                    No published properties in
                                    <span t-esc="country.name"/>
                                    yet. Please check back soon or
                                    <a href="/consultation">contact us</a>
                                    for early-bird listings.
                                </div>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- CTA -->
                <div class="text-center mt-5">
                    <a class="btn btn-primary btn-lg" href="/consultation">
                        <span class="fa fa-envelope" title="Contact"/>
                        Request a consultation about
                        <span t-esc="country.name"/>
                    </a>
                </div>
            </div>
        </t>
    </template>

</odoo>
